<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>Admin | The Little Atelier</title>
<style>
  :root { --ink:#2B2321; --cream:#FFF8EE; --white:#fff; --line:#2B2321; --soft:#E9DFD0; --muted:#6F6560; --coral:#E8695B; --coral-soft:#FBD9D3; --sage-soft:#DDEBD9; --yellow-soft:#FDEFC4; }
  * { box-sizing: border-box; }
  body { margin:0; font:15px/1.5 "DM Sans", system-ui, sans-serif; background:var(--cream); color:var(--ink); }
  h1,h2,h3 { font-family: "Playfair Display", Georgia, serif; margin:0 0 12px; }
  a { color:inherit; }
  .hidden { display:none !important; }
  .btn { display:inline-flex; align-items:center; justify-content:center; gap:6px; min-height:40px; padding:0 16px; font:inherit; font-weight:700; font-size:14px; background:var(--coral); color:var(--ink); border:2px solid var(--line); border-radius:999px; cursor:pointer; text-decoration:none; }
  .btn.ghost { background:var(--white); } .btn.dark { background:var(--ink); color:var(--cream); } .btn.small { min-height:32px; padding:0 12px; font-size:13px; }
  .btn.danger { background:var(--coral-soft); } .btn[disabled] { opacity:.5; cursor:not-allowed; }
  input, select, textarea { font:inherit; width:100%; min-height:40px; padding:8px 12px; border:2px solid var(--line); border-radius:10px; background:var(--white); color:var(--ink); }
  textarea { min-height:72px; resize:vertical; }
  label { display:block; font-size:12px; font-weight:700; margin:0 0 4px; }
  .field { margin-bottom:12px; }
  .hint { font-size:12px; color:var(--muted); }
  .panel { background:var(--white); border:2px solid var(--line); border-radius:14px; padding:18px; margin-bottom:16px; }
  .login { max-width:380px; margin:12vh auto; padding:0 16px; }
  header.top { display:flex; flex-wrap:wrap; align-items:center; gap:10px 18px; padding:12px 20px; background:var(--white); border-bottom:2px solid var(--line); position:sticky; top:0; z-index:5; }
  header.top b { font-family:Georgia,serif; font-size:18px; }
  nav.tabs { display:flex; gap:6px; flex-wrap:wrap; flex:1; }
  nav.tabs button { background:none; border:2px solid transparent; border-radius:999px; padding:5px 14px; font:inherit; font-weight:700; cursor:pointer; }
  nav.tabs button[aria-current="true"] { border-color:var(--line); background:var(--yellow-soft); }
  main { max-width:1150px; margin:0 auto; padding:20px 16px 80px; }
  .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(170px,1fr)); gap:12px; margin-bottom:16px; }
  .stat { border:2px solid var(--line); border-radius:12px; padding:12px 14px; background:var(--white); }
  .stat b { display:block; font-size:24px; font-family:Georgia,serif; } .stat span { font-size:12px; color:var(--muted); }
  .stat.warn { background:var(--coral-soft); }
  table { width:100%; border-collapse:collapse; font-size:14px; }
  th, td { text-align:left; padding:8px 10px; border-bottom:2px solid var(--soft); vertical-align:top; }
  th { font-size:11px; letter-spacing:.08em; text-transform:uppercase; color:var(--muted); }
  td.num, th.num { text-align:right; white-space:nowrap; }
  .scroll { overflow-x:auto; }
  tr.click { cursor:pointer; } tr.click:hover { background:var(--cream); }
  .chip { display:inline-block; padding:2px 10px; border:2px solid var(--line); border-radius:999px; font-size:12px; font-weight:700; background:var(--yellow-soft); }
  .chip.good { background:var(--sage-soft); } .chip.bad { background:var(--coral-soft); }
  .filters { display:grid; grid-template-columns:repeat(auto-fit,minmax(140px,1fr)); gap:10px; align-items:end; margin-bottom:12px; }
  .row { display:flex; gap:10px; flex-wrap:wrap; align-items:center; }
  .two { display:grid; grid-template-columns:1fr 1fr; gap:16px; } @media (max-width:800px){ .two { grid-template-columns:1fr; } }
  .msg { padding:10px 14px; border:2px solid var(--line); border-radius:10px; margin:10px 0; font-weight:600; background:var(--yellow-soft); }
  .msg.bad { background:var(--coral-soft); } .msg.ok { background:var(--sage-soft); }
  .modal { position:fixed; inset:0; background:rgba(43,35,33,.55); display:flex; align-items:flex-start; justify-content:center; overflow:auto; padding:24px 12px; z-index:20; }
  .modal > div { background:var(--cream); border:2px solid var(--line); border-radius:16px; padding:20px; width:100%; max-width:760px; }
  .kv { display:grid; grid-template-columns:130px 1fr; gap:4px 12px; font-size:14px; } .kv dt { color:var(--muted); font-weight:700; } .kv dd { margin:0; word-break:break-word; }
</style>
</head>
<body>
<div id="loginView" class="login hidden">
  <div class="panel">
    <h1>Admin sign in</h1>
    <form id="loginForm">
      <div class="field"><label for="em">Email</label><input id="em" type="email" autocomplete="username" required></div>
      <div class="field"><label for="pw">Password</label><input id="pw" type="password" autocomplete="current-password" required></div>
      <button class="btn dark" style="width:100%" id="loginBtn">Sign in</button>
      <div id="loginMsg" class="msg bad hidden" role="alert"></div>
    </form>
  </div>
</div>

<div id="appView" class="hidden">
  <header class="top">
    <b>The Little Atelier · Admin</b>
    <nav class="tabs" id="tabs"></nav>
    <span class="hint" id="who"></span>
    <button class="btn small ghost" id="logout">Sign out</button>
  </header>
  <main id="main"></main>
</div>
<div id="modalRoot"></div>

<script>
(function () {
  const $ = (s) => document.querySelector(s);
  const money = (p) => "₹" + (p / 100).toLocaleString("en-IN", { maximumFractionDigits: 2 });
  const fmt = (iso) => iso ? new Date(iso).toLocaleString("en-IN", { day: "numeric", month: "short", year: "2-digit", hour: "numeric", minute: "2-digit" }) : "";
  function h(tag, props, ...kids) {
    const el = document.createElement(tag);
    if (props) for (const [k, v] of Object.entries(props)) {
      if (v === null || v === undefined || v === false) continue;
      if (k === "class") el.className = v; else if (k === "text") el.textContent = v;
      else if (k.startsWith("on")) el.addEventListener(k.slice(2), v); else if (k === "value") el.value = v;
      else el.setAttribute(k, v === true ? "" : v);
    }
    for (const kid of kids.flat()) { if (kid === null || kid === undefined || kid === false) continue; el.append(kid.nodeType ? kid : document.createTextNode(String(kid))); }
    return el;
  }
  const STATES = ["Andaman and Nicobar Islands","Andhra Pradesh","Arunachal Pradesh","Assam","Bihar","Chandigarh","Chhattisgarh","Dadra and Nagar Haveli and Daman and Diu","Delhi","Goa","Gujarat","Haryana","Himachal Pradesh","Jammu and Kashmir","Jharkhand","Karnataka","Kerala","Ladakh","Lakshadweep","Madhya Pradesh","Maharashtra","Manipur","Meghalaya","Mizoram","Nagaland","Odisha","Puducherry","Punjab","Rajasthan","Sikkim","Tamil Nadu","Telangana","Tripura","Uttar Pradesh","Uttarakhand","West Bengal"];
  const ORDER_ST = ["Pending","Payment Pending","Paid","Processing","Shipped","Out for Delivery","Delivered","Cancelled","Refund Initiated","Refunded"];
  const PAY_ST = ["Pending","Successful","Failed","Cancelled","Refunded"];

  // The login token is kept in sessionStorage only (cleared when the tab closes).
  let tok = null, refreshTok = null, email = "";
  try { tok = sessionStorage.getItem("tla_at"); refreshTok = sessionStorage.getItem("tla_rt"); email = sessionStorage.getItem("tla_em") || ""; } catch (e) {}
  function saveTok(r) { tok = r.access_token; refreshTok = r.refresh_token; email = r.email; try { sessionStorage.setItem("tla_at", tok); sessionStorage.setItem("tla_rt", refreshTok); sessionStorage.setItem("tla_em", email); } catch (e) {} }
  function clearTok() { tok = refreshTok = null; try { sessionStorage.clear(); } catch (e) {} }

  async function raw(action, opts, query) {
    opts = opts || {};
    const qs = new URLSearchParams(Object.assign({ action }, query || {})).toString();
    return fetch("/api/admin?" + qs, { method: opts.body ? "POST" : "GET",
      headers: Object.assign({}, opts.body ? { "Content-Type": "application/json" } : {}, tok ? { Authorization: "Bearer " + tok } : {}),
      body: opts.body ? JSON.stringify(opts.body) : undefined });
  }
  async function call(action, opts, query) {
    let r = await raw(action, opts, query);
