    if (opts && opts.blob && r.ok) return r.blob();
    let d = null; try { d = await r.json(); } catch (e) {}
    if (!r.ok) throw new Error((d && d.error) || "Something went wrong.");
    return d;
  }

  // ---------- login ----------
  $("#loginForm").addEventListener("submit", async (e) => {
    e.preventDefault();
    const b = $("#loginBtn"), m = $("#loginMsg"); b.disabled = true; m.classList.add("hidden");
    try {
      const r = await fetch("/api/admin?action=login", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ email: $("#em").value, password: $("#pw").value }) });
      const d = await r.json().catch(() => ({}));
      if (!r.ok) throw new Error(d.error || "Could not sign in.");
      saveTok(d); $("#pw").value = ""; show();
    } catch (err) { m.textContent = err.message; m.classList.remove("hidden"); }
    b.disabled = false;
  });
  $("#logout").addEventListener("click", () => { clearTok(); show(); });

  const TABS = [["overview", "Overview"], ["orders", "Orders"], ["products", "Products"], ["customers", "Customers"], ["reports", "Reports"], ["settings", "Shipping"]];
  let tab = "overview";
  function show() {
    const on = !!tok;
    $("#loginView").classList.toggle("hidden", on); $("#appView").classList.toggle("hidden", !on);
    if (!on) return;
    $("#who").textContent = email;
    const t = $("#tabs"); t.textContent = "";
    TABS.forEach(([k, l]) => t.append(h("button", { type: "button", "aria-current": String(k === tab), onclick: () => { tab = k; show(); } }, l)));
    render();
  }
  const err = (box, e) => { box.textContent = ""; box.append(h("div", { class: "msg bad", role: "alert", text: e.message })); };
  function render() {
    const main = $("#main"); main.textContent = ""; main.append(h("p", { class: "hint", text: "Loading…" }));
    ({ overview: vOverview, orders: vOrders, products: vProducts, customers: vCustomers, reports: vReports, settings: vSettings })[tab](main).catch((e) => err(main, e));
  }
  const statusChip = (o) => h("span", { class: "chip " + (["Cancelled", "Refunded", "Refund Initiated"].includes(o.order_status) ? "bad" : o.payment_status === "Successful" ? "good" : ""), text: o.order_status });

  // ---------- overview ----------
  async function vOverview(main) {
    const [s, st] = await Promise.all([call("stats"), call("settings")]);
    main.textContent = "";
    if (!st.shipping.configured) main.append(h("div", { class: "msg bad", role: "alert" }, "Shipping charges are not set, so customers cannot check out yet. Go to the Shipping tab and save your charges (use 0 if delivery is free)."));
    const c = s.counts;
    const stat = (n, l, warn) => h("div", { class: "stat" + (warn && n ? " warn" : "") }, h("b", { text: n }), h("span", { text: l }));
    main.append(h("h2", { text: "Overview" }),
      h("div", { class: "grid" }, stat(money(s.todaySales), "Sales today (paid)"), stat(s.todayOrders, "Paid orders today"), stat(money(s.totalSales), "Total sales (paid)"), stat(s.paidOrders, "Total paid orders")),
      h("div", { class: "grid" }, stat(c.to_process, "Paid, to start"), stat(c.processing, "Processing"), stat(c.shipped, "Shipped"), stat(c.delivered, "Delivered"),
        stat(c.awaiting_payment, "Awaiting payment"), stat(c.cancelled, "Cancelled"), stat(c.refunds, "Refunds"), stat(c.attention, "Need your attention", true)));
    if (c.attention) main.append(h("button", { class: "btn danger", onclick: () => { orderFilter = { attention: "1" }; tab = "orders"; show(); } }, "Show orders that need attention"));
  }

  // ---------- orders ----------
  let orderFilter = {}; let orderPage = 1;
  async function vOrders(main) {
    const f = orderFilter;
    const fin = (id, label, type, val) => h("div", null, h("label", { for: id, text: label }), h("input", { id, type, value: val || "" }));
    const sel = (id, label, opts, val) => h("div", null, h("label", { for: id, text: label }), h("select", { id }, h("option", { value: "", text: "All" }), opts.map((o) => h("option", { value: o, text: o, selected: o === val }))));
    const form = h("form", { class: "filters" },
      fin("f-q", "Search (order ID, name, mobile)", "search", f.q), sel("f-status", "Order status", ORDER_ST, f.status), sel("f-pay", "Payment", PAY_ST, f.pay),
      fin("f-from", "From", "date", f.from), fin("f-to", "To", "date", f.to),
      h("button", { class: "btn dark" }, "Filter"));
    form.addEventListener("submit", (e) => { e.preventDefault(); orderFilter = { q: $("#f-q").value, status: $("#f-status").value, pay: $("#f-pay").value, from: $("#f-from").value, to: $("#f-to").value, attention: f.attention }; orderPage = 1; render(); });
    const query = () => { const q = {}; Object.entries(orderFilter).forEach(([k, v]) => { if (v) q[k] = v; }); return q; };
    const d = await call("orders", null, Object.assign(query(), { page: orderPage }));
    main.textContent = "";
    main.append(h("div", { class: "row", style: "justify-content:space-between" }, h("h2", { text: "Orders" }),
      h("button", { class: "btn ghost small", onclick: async (e) => { e.target.disabled = true; try { const b = await call("export", { blob: true }, query()); const a = h("a", { href: URL.createObjectURL(b), download: "orders.csv" }); document.body.append(a); a.click(); a.remove(); } catch (x) { alert(x.message); } e.target.disabled = false; } }, "Download CSV")),
      h("div", { class: "panel" }, form));
    if (f.attention) main.append(h("div", { class: "msg" }, "Showing only orders that need attention. ", h("button", { class: "btn small ghost", onclick: () => { orderFilter = {}; render(); } }, "Clear")));
    const t = h("table", null, h("thead", null, h("tr", null, ["Order", "Date", "Customer", "Status", "Payment", "Total"].map((x, i) => h("th", { class: i === 5 ? "num" : "", text: x })))),
      h("tbody", null, d.orders.map((o) => h("tr", { class: "click", tabindex: "0", onclick: () => openOrder(o.id), onkeydown: (e) => { if (e.key === "Enter") openOrder(o.id); } },
        h("td", null, h("b", { text: o.order_no }), o.needs_attention ? h("span", { class: "chip bad", style: "margin-left:6px", text: "Check" }) : null),
        h("td", { text: fmt(o.created_at) }), h("td", null, o.customer_name, h("div", { class: "hint", text: o.mobile })), h("td", null, statusChip(o)),
        h("td", { text: o.payment_status + (o.payment_method ? " · " + o.payment_method : "") }), h("td", { class: "num", text: money(o.total_paise) })))));
    main.append(h("div", { class: "panel scroll" }, d.orders.length ? t : h("p", { text: "No orders found." })));
    const pages = Math.max(1, Math.ceil(d.total / d.limit));
    main.append(h("div", { class: "row" }, h("button", { class: "btn small ghost", disabled: orderPage <= 1, onclick: () => { orderPage--; render(); } }, "← Previous"),
      h("span", { class: "hint", text: "Page " + orderPage + " of " + pages + " · " + d.total + " orders" }),
      h("button", { class: "btn small ghost", disabled: orderPage >= pages, onclick: () => { orderPage++; render(); } }, "Next →")));
  }

  function modal(content) {
    const root = $("#modalRoot"); root.textContent = "";
    const close = () => { root.textContent = ""; };
    root.append(h("div", { class: "modal", role: "dialog", "aria-modal": "true", onclick: (e) => { if (e.target.classList.contains("modal")) close(); } },
      h("div", null, h("div", { class: "row", style: "justify-content:flex-end" }, h("button", { class: "btn small ghost", onclick: close }, "Close")), content)));
    return close;
  }

  async function openOrder(id) {
    const box = h("div", null, h("p", { text: "Loading…" }));
    const close = modal(box);
    async function load() {
      let d; try { d = await call("order", null, { id }); } catch (e) { err(box, e); return; }
      const o = d.order; box.textContent = "";
      const msg = h("div", { role: "status" });
      const act = async (fn, okText) => { msg.textContent = ""; try { const r = await fn(); msg.append(h("div", { class: "msg ok", text: okText(r) })); await load(); box.prepend(msg); } catch (e) { msg.append(h("div", { class: "msg bad", role: "alert", text: e.message })); } };
      const paid = o.payment_status === "Successful";
      const fulfil = ["Processing", "Shipped", "Out for Delivery", "Delivered"];
      const canMove = paid && !["Cancelled", "Refund Initiated", "Refunded"].includes(o.order_status);
      const statusSel = h("select", { id: "o-status", "aria-label": "New status" }, fulfil.map((s) => h("option", { value: s, text: s, selected: s === o.order_status })));
      const car = h("input", { id: "o-car", value: o.tracking_carrier || "", maxlength: 60 }), num = h("input", { id: "o-num", value: o.tracking_number || "", maxlength: 80 }), url = h("input", { id: "o-url", value: o.tracking_url || "", maxlength: 300, placeholder: "https://" });
      const notes = h("textarea", { id: "o-notes", maxlength: 1000 }, o.notes || "");
      const wa = "https://wa.me/91" + o.mobile + "?text=" + encodeURIComponent("Hi " + o.customer_name + ", this is The Little Atelier about your order " + o.order_no + ".");
      box.append(msg, h("h2", { text: o.order_no }),
        o.needs_attention ? h("div", { class: "msg bad" }, "This order needs your attention (for example a payment arrived after the order was cancelled, or an amount or stock problem). Check Razorpay, then press Mark as checked.", h("div", { style: "margin-top:8px" }, h("button", { class: "btn small", onclick: () => act(() => call("order-update", { body: { id, resolve: true } }), () => "Marked as checked.") }, "Mark as checked"))) : null,
        h("div", { class: "two" },
          h("div", { class: "panel" }, h("h3", { text: "Customer" }), h("dl", { class: "kv" },
            h("dt", { text: "Name" }), h("dd", { text: o.customer_name }), h("dt", { text: "Mobile" }), h("dd", { text: o.mobile }), h("dt", { text: "Email" }), h("dd", { text: o.email || "-" }),
            h("dt", { text: "Address" }), h("dd", { text: [o.address, o.landmark, o.city + ", " + o.state + " " + o.pincode].filter(Boolean).join(", ") }), h("dt", { text: "Instructions" }), h("dd", { text: o.instructions || "-" })),
            h("p", null, h("a", { class: "btn small ghost", href: wa, target: "_blank", rel: "noopener" }, "WhatsApp customer"))),
          h("div", { class: "panel" }, h("h3", { text: "Payment" }), h("dl", { class: "kv" },
            h("dt", { text: "Order status" }), h("dd", null, statusChip(o)), h("dt", { text: "Payment" }), h("dd", { text: o.payment_status + (o.payment_method ? " · " + o.payment_method : "") }),
            h("dt", { text: "Razorpay ID" }), h("dd", { text: o.payment_ref || "-" }), h("dt", { text: "Placed" }), h("dd", { text: fmt(o.created_at) }), h("dt", { text: "Paid" }), h("dd", { text: fmt(o.paid_at) || "-" }),
            h("dt", { text: "Coupon" }), h("dd", { text: o.coupon_code || "-" })))),
        h("div", { class: "panel scroll" }, h("h3", { text: "Items" }), h("table", null, h("tbody", null,
          d.items.map((i) => h("tr", null, h("td", { text: i.qty + " × " + i.name + (i.variant_label ? " (" + i.variant_label + ")" : "") }), h("td", { class: "num", text: money(i.line_total_paise) }))),
          h("tr", null, h("td", { text: "Subtotal" }), h("td", { class: "num", text: money(o.subtotal_paise) })),
          o.discount_paise ? h("tr", null, h("td", { text: "Discount" }), h("td", { class: "num", text: "−" + money(o.discount_paise) })) : null,
          h("tr", null, h("td", { text: "Shipping" }), h("td", { class: "num", text: money(o.shipping_paise) })),
          h("tr", null, h("td", null, h("b", { text: "Total" })), h("td", { class: "num" }, h("b", { text: money(o.total_paise) })))))),
        h("div", { class: "panel" }, h("h3", { text: "Update order" }),
          canMove ? h("div", { class: "row" }, h("div", { style: "flex:1;min-width:180px" }, statusSel),
            h("button", { class: "btn dark", onclick: () => act(() => call("order-update", { body: { id, status: statusSel.value } }), () => "Status updated.") }, "Update status"))
            : h("p", { class: "hint", text: paid ? "This order is closed, so its status cannot be changed." : "The status can be changed only after payment is verified." }),
          h("div", { class: "form-grid", style: "margin-top:12px" },
            h("div", { class: "field" }, h("label", { for: "o-car", text: "Courier" }), car), h("div", { class: "field" }, h("label", { for: "o-num", text: "Tracking number" }), num),
            h("div", { class: "field" }, h("label", { for: "o-url", text: "Tracking link" }), url), h("div", { class: "field" }, h("label", { for: "o-notes", text: "Private notes (never shown to customer)" }), notes)),
          h("button", { class: "btn", onclick: () => act(() => call("order-update", { body: { id, tracking: { carrier: car.value, number: num.value, url: url.value }, notes: notes.value } }), () => "Saved.") }, "Save tracking and notes")),
        h("div", { class: "panel" }, h("h3", { text: "Cancel or refund" }),
          h("div", { class: "row" },
            ["Pending", "Payment Pending", "Paid", "Processing"].includes(o.order_status) ? h("button", { class: "btn danger", onclick: () => { if (confirm("Cancel order " + o.order_no + "?")) act(() => call("order-cancel", { body: { id } }), (r) => r.refundNeeded ? "Order cancelled. This order was paid, so now issue a refund." : "Order cancelled."); } }, "Cancel order") : null,
